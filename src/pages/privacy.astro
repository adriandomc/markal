---
import "@phosphor-icons/web/regular";
import "../styles.scss";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Markal — Privacidad / Privacy</title>
    <meta
      name="description"
      content="Cómo Markal maneja tus datos: sin servidores centrales, sin tracking, todo local o en tu propia nube. / How Markal handles your data: no central servers, no tracking, local or in your own cloud."
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("markal.locale");
          var initial = stored === "es" || stored === "en"
            ? stored
            : (navigator.language || "es").toLowerCase().split("-")[0];
          var locale = initial === "en" ? "en" : "es";
          document.documentElement.setAttribute("lang", locale);
          document.documentElement.setAttribute("data-locale", locale);
        } catch (_) {
          document.documentElement.setAttribute("data-locale", "es");
        }
      })();
    </script>
    <style is:global>
      html[data-locale="es"] [data-locale-content="en"],
      html[data-locale="en"] [data-locale-content="es"] {
        display: none;
      }
      .legal-page {
        max-width: 44rem;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
        color: var(--ink);
      }
      .legal-page header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }
      .legal-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--ink);
        font-weight: 700;
        font-size: 1.05rem;
      }
      .legal-brand img {
        width: 2rem;
        height: 2rem;
        display: block;
      }
      .legal-locale {
        display: inline-flex;
        border: 1px solid var(--border);
        border-radius: 999px;
        overflow: hidden;
        background: var(--surface);
      }
      .legal-locale button {
        appearance: none;
        background: transparent;
        border: 0;
        color: var(--muted);
        font: inherit;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.3rem 0.7rem;
        cursor: pointer;
      }
      .legal-locale button.is-active {
        background: var(--ink);
        color: var(--page);
      }
      .legal-page article h1 {
        font-size: 1.75rem;
        margin: 0 0 0.5rem;
      }
      .legal-page article h2 {
        font-size: 1.05rem;
        margin: 2rem 0 0.5rem;
        font-weight: 700;
      }
      .legal-page article p,
      .legal-page article li {
        font-size: 0.94rem;
        line-height: 1.55;
      }
      .legal-page .meta {
        color: var(--muted);
        font-size: 0.84rem;
        margin: 0 0 1.5rem;
      }
      .legal-page .lead {
        font-size: 1rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.9rem 1rem;
        line-height: 1.5;
      }
      .legal-page article a {
        color: var(--ink);
        text-underline-offset: 3px;
      }
      .legal-page article code {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.85em;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.05em 0.35em;
      }
      .legal-page article ul {
        padding-left: 1.25rem;
      }
      .legal-page article li + li {
        margin-top: 0.4rem;
      }
      .legal-page footer {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        font-size: 0.88rem;
      }
      .legal-page footer a {
        color: var(--muted);
        text-decoration: none;
      }
      .legal-page footer a:hover {
        color: var(--ink);
      }
    </style>
  </head>
  <body>
    <main class="legal-page">
      <header>
        <a href="/" class="legal-brand">
          <img src="/favicon.svg" alt="Markal" width="32" height="32" />
          Markal
        </a>
        <div class="legal-locale" role="group" aria-label="Idioma / Language">
          <button type="button" data-locale-toggle="es" aria-label="Español">
            ES
          </button>
          <button type="button" data-locale-toggle="en" aria-label="English">
            EN
          </button>
        </div>
      </header>

      <markal-privacy></markal-privacy>
      <markal-site-footer></markal-site-footer>
    </main>

    <script>
      import "../components/markal-privacy.ts";
      import "../components/markal-site-footer.ts";
      import { initLocalization, changeLocale } from "../i18n/setup.ts";

      const doc = document.documentElement;

      function updateActive() {
        const current = doc.getAttribute("data-locale") || "es";
        document.querySelectorAll("[data-locale-toggle]").forEach((btn) => {
          const target = btn.getAttribute("data-locale-toggle");
          btn.classList.toggle("is-active", target === current);
          btn.setAttribute(
            "aria-pressed",
            target === current ? "true" : "false"
          );
        });
      }

      // Inicializa la localización usando el sistema de Lit y actualiza botones
      initLocalization().then(() => {
        updateActive();

        // Suscribe cambios de idioma para botones en header
        document.querySelectorAll("[data-locale-toggle]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const locale = btn.getAttribute("data-locale-toggle") || "es";
            changeLocale(locale as any).then(() => {
              updateActive();
            });
          });
        });
      });
    </script>
  </body>
</html>
