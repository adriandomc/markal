---
import "@phosphor-icons/web/regular";
import "../../styles.scss";

// roomId is read from URL pathname client-side in app.ts; we don't need it
// here (and shouldn't, because the encryption key lives in the URL fragment
// which never reaches the server).
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>Markal — Calendario compartido</title>
    <meta
      name="description"
      content="Unirse a un calendario compartido en Markal. Los datos viajan cifrados directamente entre dispositivos."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <markal-app></markal-app>
    <script>
      import "../../app.ts";
    </script>
  </body>
</html>
