---
import "@phosphor-icons/web/regular";
import "../styles.scss";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>Markal</title>
    <meta
      name="description"
      content="Markal is a tool for building markable calendars. Just pick a date range, set legend colors, and start marking your calendar!"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Markal" />
    <meta property="og:title" content="Markal" />
    <meta
      property="og:description"
      content="Markal is a tool for building markable calendars. Just pick a date range, set legend colors, and start marking your calendar!"
    />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:locale" content="es" />
    <meta property="og:locale:alternate" content="en" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Markal" />
    <meta
      name="twitter:description"
      content="Markal is a tool for building markable calendars. Just pick a date range, set legend colors, and start marking your calendar!"
    />
    <meta name="twitter:image" content="/og-image.png" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("markal.locale");
          var nav = (navigator.language || "es").toLowerCase().split("-")[0];
          var locale = stored === "es" || stored === "en"
            ? stored
            : (nav === "en" ? "en" : "es");
          document.documentElement.setAttribute("lang", locale);
          document.documentElement.setAttribute("data-locale", locale);
        } catch (_) {
          document.documentElement.setAttribute("data-locale", "es");
        }
      })();
    </script>
    <style is:global>
      html[data-locale="es"] [data-locale-content="en"],
      html[data-locale="en"] [data-locale-content="es"] {
        display: none;
      }
      .site-footer {
        position: relative;
        padding: 1.25rem 1.5rem 1.75rem;
        text-align: center;
        font-size: 0.78rem;
        color: var(--muted);
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .site-footer a {
        color: inherit;
        text-decoration: none;
      }
      .site-footer a:hover,
      .site-footer a:focus-visible {
        color: var(--ink);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <markal-app></markal-app>
    <footer class="site-footer">
      <a href="/privacy" data-locale-content="es">Privacidad</a>
      <a href="/privacy" data-locale-content="en">Privacy</a>
      <a
        href="https://github.com/adriandomc/markal"
        target="_blank"
        rel="noopener noreferrer"
      >GitHub</a>
    </footer>
    <script>
      import "../app.ts";
    </script>
  </body>
</html>
